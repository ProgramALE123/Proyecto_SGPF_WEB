{
  "name": "sgpf-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "install:all": "npm ci --prefix SGPF.backend-main && npm ci --include=dev --prefix SGPF_FRONTEND",
